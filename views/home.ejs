        </span>
      </div>
    </div>
    <span></span>
    <div style="position: relative">
      <button
        title="start multiple searches"
        onclick="multipleSearch()"
        style="letter-spacing: 1px"
        class="btn btn-info px-4 text-white mt-3 bt1 ms-4 ms-md-0"
      >
        Start
      </button>
      <span class="eta"></span>
      <span class="text-muted infosearch">
        <span class="btn btn-sm btn-secondary rounded-pill show1">Delay</span>
        <span class="ms-3 btn btn-sm btn-secondary rounded-pill hide1 d-none"
          >Hide</span
        >
      </span>
    </div>
    <div class="delaydiv delaydiv1" style="opacity: 0">
      <div class="d-inline">
        <span class="" style="font-size: 1.1em; font-weight: 500"
          >Delay<small>
            (sec)
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              fill="currentColor"
              class="bi bi-info-circle-fill text-secondary delayinfo"
              viewBox="0 0 16 16"
            >
              <path
                d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"
              /></svg></small
        ></span>
        <div
          class="btn-group d-flex justify-content-start align-items-center mt-2"
          role="group"
          aria-label="Basic radio toggle button group"
        >
          <input
            type="radio"
            class="btn-check"
            name="btnradio"
            id="btnradio1"
            autocomplete="off"
            checked
          />
          <label
            class="btn btn-sm btn-outline-success p1"
            style="position: relative"
            for="btnradio1"
            >Default
            <lable
              class="px-1 py-1 default"
              style="
                position: absolute;
                top: 2.5em;
                left: 0.5em;
                color: white;
                border-radius: 0.3em;
                background-color: rgba(0, 0, 0, 0.7);
              "
            >
              2 sec
            </lable></label
          >

          <input
            type="radio"
            class="btn-check"
            name="btnradio"
            id="btnradio2"
            autocomplete="off"
          />
          <label
            class="btn btn-sm btn-outline-danger p2"
            style="position: relative"
            for="btnradio2"
            >Random<lable
              class="random"
              style="
                position: absolute;
                top: 2.4em;
                left: 0.5em;
                color: white;
                border-radius: 0.3em;
                background-color: rgba(0, 0, 0, 0.7);
              "
              >1.5-4.5 sec</lable
            ></label
          >

          <input
            type="radio"
            class="btn-check"
            name="btnradio"
            id="btnradio3"
            autocomplete="off"
          />
          <label
            class="btn btn-sm btn-outline-primary p3"
            style="position: relative"
            for="btnradio3"
            >Manual<span class="menual"
              ><lable
                style="
                  position: absolute;
                  top: 3.15em;
                  left: 3em;
                  color: black;
                  z-index: 5;
                  font-size: 1.1em;
                "
                >S</lable
              ><input
                type="number"
                min="1"
                max="20"
                step="any"
                pattern="[1-20](\.[0-9])?"
                class="form-control py-1 minput mt-2"
                style="
                  position: absolute;
                  top: 2.2em;
                  left: 0.5em;
                  z-index: 0;
                  border: 1px solid #5c636a;
                "
              /><button
                title="apply menual delay"
                style="position: absolute; top: 3.2em; left: 5.8em"
                class="btn btn-sm btn-success msave"
              >
                Save</button
              ><span class="t1">Success!</span>
            </span>
          </label>
        </div>
      </div>
    </div>

    <div id="container " class="container micro1">
      <a href="https://rewards.bing.com" class="btn btn-secondary msw1"
        >Go To<b> Microsoft | Rewards</b>
        <?xml version="1.0" encoding="utf-8"?>
        <!-- Generator: Adobe Illustrator 19.0.1, SVG Export Plug-In . SVG Version: 6.00 Build 0)  -->
        <svg
          version="1.1"
          id="loading-icon"
          xmlns="http://www.w3.org/2000/svg"
          xmlns:xlink="http://www.w3.org/1999/xlink"
          x="0px"
          y="0px"
          viewBox="922 -1145 736 736"
          style="enable-background: new 922 -1145 736 736"
          xml:space="preserve"
        >
          <rect id="rect0" x="1059.3" y="-1007.7" width="174" height="174" />
          <rect id="rect1" x="1346.7" y="-1007.7" width="174" height="174" />
          <rect id="rect2" x="1346.7" y="-720.3" width="174" height="174" />
          <rect id="rect3" x="1059.3" y="-720.3" width="174" height="174" />
        </svg>
      </a>
    </div>

    <div
      class="modal fade"
      id="exampleModal6"
      tabindex="-1"
      aria-labelledby="exampleModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Delay (info)</h5>
          </div>
          <div class="modal-body">
            <span class="d-block">
              <b>Default Option:</b>This option sets a default delay of
              <b> 2 seconds </b>for Each Search/Opened tab.This is the default
              delay and it ensures fast auto search on most devices with
              variable net speeds
            </span>

            <span class="d-block">
              <b>Random Option:</b> Selecting this option will sets random delay
              between <b> 1s to 4.5s seconds</b> for Each Search/Opened
              tab.Using this option, time for autosearch may varry.</span
            >

            <span class="d-block">
              <b> Manual Option: </b>By clicking on this option, users can
              manually set their preferred delay range for Each Search/opened
              tabs. Users have the flexibility to adjust the delay time between
              <b> 1 second and 20 seconds </b> according to their
              preferences.</span
            >
          </div>
          <div class="modal-footer">
            <span class="text-muted"
              ><small
                >Each Opened Search/tab is closed after<br />
                (delay x 2.3sec)</small
              >
            </span>
            <button
              title="close model"
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
    <button
      id="bt6"
      title="model toggle"
      type="button"
      class="visually-hidden"
      data-bs-toggle="modal"
      data-bs-target="#exampleModal6"
    ></button>

    <div
      class="modal fade"
      id="exampleModal"
      tabindex="-1"
      aria-labelledby="exampleModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Search Done</h5>
            <button
              title="via icon close success model"
              title="model"
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body" style="display: flex; flex-direction: column">
            Task Executed Successfully!<br />

            <div class="adunit1" style="flex-grow: 1"></div>
          </div>
          <div class="modal-footer">
            <button
              title="close success model"
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
    <!-- Modal -->
    <div
      class="modal fade"
      id="exampleModal3"
      tabindex="-1"
      aria-labelledby="exampleModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Search Failed!</h5>
            <button
              title="icont to close failed msg model"
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            Please Enable/Allow Pop-ups from top of the page and try again!
            Pop-ups permission is required to execute search task.
          </div>
          <% if(isMobile){ %>

          <a href="https://youtube.com/shorts/dRAnd4bhNoM?feature=share"
            >Click Here to watch video on how to enable/allow Pop-ups</a
          >
          <% }else{ %>
          <a href="https://youtu.be/-Qh1nXSgfYg"
            >Click Here to watch video on how to enable/allow Pop-ups</a
          >

          <% } %>
          <div class="modal-footer">
            <button
              title="close failed msg model"
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
    <button
      title="model3 toggle"
      id="bt4"
      type="button"
      class="visually-hidden"
      data-bs-toggle="modal"
      data-bs-target="#exampleModal3"
    ></button>
    <!-- Button trigger modal -->
    <button
      title="model1 toggle"
      id="bt2"
      type="button"
      class="visually-hidden"
      data-bs-toggle="modal"
      data-bs-target="#exampleModal"
    ></button>

    <script src="static/js/main.js"></script>

    <script>


      // Search Input values based on device,country/user preferences etc.

      let count = 0;
      let country_code = `<%=country_code%>`
      let isMobile = <%= isMobile %>;
      let searchValue;
      if(country_code=='US'){
      if(isMobile){
      searchValue=100/5+10;
      }else{
      searchValue=150/5+10;
      }
      }else if(country_code=='GB'){
      if  (isMobile){
          searchValue=60/3+9;
      }else{
        searchValue=90/3+9;
      }
      }else{
        if(isMobile){
          searchValue=60/3+7;
      }else{
        searchValue=90/3+7;
      }
      }


      number.value= searchValue;

      const storedValue = localStorage.getItem("sv");
      const storedDelay = localStorage.getItem("delay");
    </script>

    <script src="static/js/eta.js"></script>

    <script>
      function reset() {
        number.value = searchValue;
      }
      let defaultSearch = searchValue;
      let isdefault = true;
      if (number.value != defaultSearch) {
        isdefault = false;
      }
      number.addEventListener("input", (e) => {
        if (number.value != defaultSearch) {
          isdefault = false;
        }
        let num1 = parseInt(number.value);
        let eta = document.querySelector(".eta");

        if (num1 == 0 || num1 > 101 || isNaN(num1)) {
          eta.innerHTML = `ETA: _`;
          return;
        }
        eta.innerHTML = `ETA:${(
          num1 * (delay / 1000) +
          (delay / 1000) * 4
        ).toFixed(2)} Sec`;
        if (localStorage.getItem("delaycat") == "random") {
          eta.innerHTML = `ETA:${(
            num1 * (delay / 1000) +
            (delay / 1000) * 4
          ).toFixed(2)} Sec <span class="dinfo">(Random Delay)</span>`;
        }
      });

      defaultz.style.display = "none";

      if (localStorage.getItem("sv") !== null) {
        defaultz.style.display = "inline-block";
      }
    </script>

    <script src="static/js/search.js"></script>

    <script>
      defaultz.addEventListener("click", () => {
        localStorage.removeItem("sv");

        defaultz.style.display = "none";
        number.value = searchValue;
      });
    </script>

    <script src="static/js/misc.js"></script>

    <script src="bootstrap/bootstrap.bundle.min.js"></script>
  </body>
</html>
