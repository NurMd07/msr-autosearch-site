          <% if(country_code == 'GB'){ %> UK <% }else{ %> <%= country_code %> <%
          } %>
        </span>
        <span
          class="d-block s2 d-flex justify-content-center align-items-center subhead3"
        >
          <% if(isMobile){ %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            class="bi bi-android2 me-1"
            viewBox="0 0 16 16"
          >
            <path
