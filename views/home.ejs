                max="20"
                step="any"
                pattern="[1-20](\.[0-9])?"
                class="form-control minput me-2"
                aria-label="Manual delay in seconds"
              /><button
                title="Apply manual delay"
                class="btn btn-sm btn-success msave"
              >
                Apply</button
              ><span class="t1" role="status">Saved</span>
              </span>
            </span>
        </div>
      </div>
