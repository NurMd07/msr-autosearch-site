          <input
            type="radio"
            class="btn-check"
            name="btnradio"
            id="btnradio2"
            autocomplete="off"
          />
          <label
            class="btn btn-sm btn-outline-danger p2 "
            style="position: relative"
            for="btnradio2"
            >Random<span
              class="random px-1"
              style="
                position: absolute;
                top: 2.4em;
                left: 0.5em;
                color: white;
                border-radius: 0.3em;
                background-color: rgba(0, 0, 0, 0.7);
              "
              >15.1–21 sec</span
