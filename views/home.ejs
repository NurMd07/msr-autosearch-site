      </lable>
      <div style="position: relative !important" class="col-4 col-lg-2">
        <input
          class="form-control text-center"
          type="number"
          name="number"
          id="number"
          value="20"
          min="1"
          max="100"
          pattern="\d{1,3}"
        />
        <span class="defaultz"
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            class="bi bi-arrow-clockwise"
            viewBox="0 0 16 16"
          >
            <path
              fill-rule="evenodd"
              d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"
            />
            <path
              d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"
            /></svg
        ></span>
      </div>
      <div
        class="col-3 col-lg-2 d-flex flex-column flex-md-row justify-content-center align-items-center"
      >
        <span
          class="d-block me-md-2 s2 d-flex justify-content-center align-items-center subhead3"
        >
