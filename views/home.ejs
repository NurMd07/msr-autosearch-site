          <label
            class="btn btn-sm btn-outline-success p1"
            style="position: relative"
            for="btnradio1"
            >Default
            <span
              class="px-1 py-1 default"
              style="
                position: absolute;
                top: 2.5em;
                left: 0.5em;
                color: white;
                border-radius: 0.3em;
                background-color: rgba(0, 0, 0, 0.7);
              "
            >
              4 sec
            </span></label
